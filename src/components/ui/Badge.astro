---
/**
 * Status pill. Reserved for genuine statuses (e.g. project state), never for
 * ordinary text. Keep counts/labels as plain text elsewhere.
 */
interface Props {
	tone?: 'neutral' | 'accent' | 'muted';
	class?: string;
}

const { tone = 'neutral', class: className } = Astro.props;

const tones = {
	neutral: 'border border-line bg-surface text-ink-soft',
	accent: 'border border-gold-main/40 bg-gold-main/12 text-violet-deep',
	muted: 'bg-surface-muted text-ink-muted',
};
---

<span class:list={['inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-medium', tones[tone], className]}>
	<slot />
</span>
