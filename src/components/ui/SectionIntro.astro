---
interface Props {
	kicker: string;
	title: string;
	description?: string;
	align?: 'left' | 'between';
}

const { kicker, title, description, align = 'left' } = Astro.props;
---

<div
	class:list={[
		'mb-6 gap-5 sm:mb-8 sm:gap-6',
		align === 'between' ? 'flex flex-col items-start justify-between lg:flex-row lg:items-end' : '',
	]}
>
	<div>
		<p class="inline-flex items-center gap-2 rounded-full border border-gold-main/25 bg-gold-main/10 px-3 py-1 text-[0.66rem] font-semibold uppercase tracking-[0.2em] text-violet-deep sm:text-xs sm:tracking-[0.24em]">
			<span class="h-1.5 w-1.5 rounded-full bg-gold-main"></span>
			{kicker}
		</p>
		<h2 class="mt-3 font-serif text-3xl leading-tight text-ink sm:text-4xl lg:text-[2.6rem]">{title}</h2>
	</div>
	{description && <p class="max-w-2xl text-sm leading-6 text-ink/62 sm:text-base sm:leading-7">{description}</p>}
</div>
