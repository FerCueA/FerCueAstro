---
interface Props {
	kicker: string;
	title: string;
	description?: string;
	index?: string;
}

const { kicker, title, description, index } = Astro.props;
---

<div>
	<div class="flex items-baseline gap-3">
		{index && (
			<span class="font-serif text-base text-gold-main" aria-hidden="true">
				{index}
			</span>
		)}
		<span class="text-xs font-medium uppercase tracking-[0.18em] text-ink-muted">{kicker}</span>
	</div>
	<h2 class="mt-3 font-serif text-3xl leading-[1.1] text-ink sm:text-4xl">{title}</h2>
	{description && <p class="mt-3 max-w-xl text-sm leading-6 text-ink-soft sm:text-base sm:leading-7">{description}</p>}
</div>
