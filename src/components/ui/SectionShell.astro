---
import SectionIntro from './SectionIntro.astro';

/**
 * Editorial section wrapper: no boxes, no shadows. Sections are separated by
 * whitespace, a hairline and typographic hierarchy instead of containers.
 *
 * Slots:
 * - `under-intro` → full-width content below the header (e.g. filters)
 * - default       → section body
 */
interface Props {
	id: string;
	index?: string;
	kicker: string;
	title: string;
	description?: string;
	meta?: string[];
}

const { id, index, kicker, title, description, meta } = Astro.props;
---

<section id={id} class="scroll-mt-24 border-t border-line py-12 sm:py-16 lg:py-20">
	<header class="grid gap-x-12 gap-y-5 lg:grid-cols-[minmax(0,1fr)_minmax(0,20rem)] lg:items-end">
		<SectionIntro index={index} kicker={kicker} title={title} />
		<div class="lg:pb-1.5">
			{description && <p class="max-w-md text-sm leading-6 text-ink-soft sm:text-base sm:leading-7">{description}</p>}
			{meta && meta.length > 0 && <p class="mt-3 text-xs uppercase tracking-[0.16em] text-ink-muted">{meta.join('  ·  ')}</p>}
		</div>
	</header>

	<slot name="under-intro" />

	<div class="pt-9 sm:pt-12">
		<slot />
	</div>
</section>
