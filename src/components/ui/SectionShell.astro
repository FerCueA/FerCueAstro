---
import SectionIntro from './SectionIntro.astro';

/**
 * Standard section wrapper: outer vertical rhythm + inner panel + header row
 * (intro on the left, badges on the right) + content.
 *
 * Slots:
 * - `badges`      → meta pills on the right of the header
 * - `under-intro` → content just below the intro (e.g. certificate filters)
 * - default       → section body
 */
interface Props {
	id: string;
	index?: string;
	kicker: string;
	title: string;
	description?: string;
}

const { id, index, kicker, title, description } = Astro.props;
---

<section id={id} class="py-10 sm:py-12 lg:py-16">
	<div class="rounded-panel border border-ink/8 bg-surface/90 p-5 shadow-soft sm:bg-surface/88 sm:p-8 sm:backdrop-blur-xl">
		<div class="mb-6 flex flex-col gap-4 sm:mb-8 sm:gap-5 lg:flex-row lg:items-end lg:justify-between">
			<div class="lg:max-w-3xl">
				<SectionIntro index={index} kicker={kicker} title={title} description={description} />
				<slot name="under-intro" />
			</div>
			<div class="flex flex-wrap items-center gap-2.5 sm:gap-3 lg:pb-8">
				<slot name="badges" />
			</div>
		</div>
		<slot />
	</div>
</section>
