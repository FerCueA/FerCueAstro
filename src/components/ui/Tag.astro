---
/**
 * Subtle label chip (technologies, stacks). Not a pill: small radius, no
 * border, muted surface. Use sparingly — prefer plain text lists when possible.
 */
interface Props {
	accent?: boolean;
	class?: string;
}

const { accent = false, class: className } = Astro.props;
---

<span
	class:list={[
		'inline-flex items-center whitespace-nowrap rounded-sm px-2 py-1 text-xs text-ink-soft sm:text-sm',
		accent ? 'bg-gold-main/12 text-violet-deep' : 'bg-surface-muted/70',
		className,
	]}
>
	<slot />
</span>
