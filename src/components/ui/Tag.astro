---
/**
 * Chip used for technologies, stacks and lists of short labels.
 * Centralises the repeated "border + soft background + colored text" pattern.
 */
interface Props {
	variant?: 'violet' | 'gold' | 'outline';
	size?: 'sm' | 'md';
	shape?: 'pill' | 'soft';
	class?: string;
}

const { variant = 'violet', size = 'md', shape = 'pill', class: className } = Astro.props;

const variants = {
	violet: 'border-violet-main/16 bg-violet-soft/35 text-violet-deep',
	gold: 'border-gold-main/20 bg-gold-main/10 text-violet-deep',
	outline: 'border-ink/10 bg-paper/85 text-ink/65',
};

const sizes = {
	sm: 'px-2.5 py-1 text-xs',
	md: 'px-3 py-1 text-xs sm:px-3.5 sm:text-sm',
};

const shapes = {
	pill: 'rounded-full',
	soft: 'rounded-inner',
};
---

<span class:list={['inline-flex items-center border font-medium', variants[variant], sizes[size], shapes[shape], className]}>
	<slot />
</span>
