---
/**
 * Shared button/link. Renders an `<a>` when `href` is provided, otherwise a
 * `<button>`. Use variants instead of ad-hoc button classes in sections.
 */
interface Props {
	href?: string;
	variant?: 'primary' | 'secondary' | 'ghost';
	size?: 'sm' | 'md' | 'lg';
	target?: '_blank' | '_self';
	rel?: string;
	type?: 'button' | 'submit';
	class?: string;
	'data-open-section'?: string;
}

const {
	href,
	variant = 'primary',
	size = 'sm',
	target = '_blank',
	rel = 'noreferrer',
	type = 'button',
	class: className,
	...rest
} = Astro.props;

const Tag = href ? 'a' : 'button';

const base = 'inline-flex items-center justify-center gap-2 rounded-full font-semibold transition hover:-translate-y-0.5';

const variants = {
	primary: 'bg-gold-main text-ink shadow-soft hover:bg-gold-soft',
	secondary: 'border border-ink/10 bg-paper text-ink hover:border-gold-main/35 hover:bg-surface',
	ghost: 'border border-gold-main/30 bg-gold-main/10 text-violet-deep hover:bg-gold-main/20',
};

const sizes = {
	sm: 'px-4 py-2 text-sm',
	md: 'px-5 py-3 text-sm sm:px-6 sm:text-base',
	lg: 'w-full px-5 py-3 text-sm sm:text-base',
};
---

<Tag class:list={[base, variants[variant], sizes[size], className]} {...(href ? { href, target, rel } : { type })} {...rest}>
	<slot />
</Tag>
