---
/**
 * Action element. Renders an `<a>` when `href` is provided, otherwise a
 * `<button>`. One clear primary per area; use `ghost` for text/section actions.
 */
interface Props {
	href?: string;
	variant?: 'primary' | 'secondary' | 'ghost';
	size?: 'sm' | 'md';
	target?: '_blank' | '_self';
	rel?: string;
	type?: 'button' | 'submit';
	class?: string;
	'data-open-section'?: string;
}

const {
	href,
	variant = 'primary',
	size = 'sm',
	target = '_blank',
	rel = 'noreferrer',
	type = 'button',
	class: className,
	...rest
} = Astro.props;

const Tag = href ? 'a' : 'button';

const base =
	'inline-flex items-center gap-2 font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold-main/40 focus-visible:ring-offset-2 focus-visible:ring-offset-paper';

const variants = {
	primary: 'justify-center rounded-md bg-gold-main text-ink hover:bg-gold-soft',
	secondary: 'justify-center rounded-md border border-line text-ink hover:bg-surface-muted',
	ghost: 'text-violet-deep hover:text-gold-main',
};

const sizes = {
	sm: 'px-3.5 py-2 text-sm',
	md: 'px-5 py-2.5 text-sm sm:text-base',
};

const sizeClass = variant === 'ghost' ? '' : sizes[size];
---

<Tag class:list={[base, variants[variant], sizeClass, className]} {...(href ? { href, target, rel } : { type })} {...rest}>
	<slot />
</Tag>
