---
/**
 * Centralised icon set. All icons come from this single source so we never
 * mix icon libraries or duplicate path data across sections.
 *
 * - Stroke icons (most): `viewBox="0 0 24 24"`, drawn with `currentColor`.
 * - Fill icons (brand/social): rendered with `fill="currentColor"`.
 */
type IconName =
	// UI / sections
	| 'monitor'
	| 'server'
	| 'brand'
	| 'custom'
	| 'code'
	| 'bolt'
	| 'bot'
	| 'clipboard'
	| 'database'
	| 'tool'
	| 'check'
	| 'arrowRight'
	| 'award'
	// Interests
	| 'chip'
	| 'spark'
	| 'mountain'
	| 'run'
	| 'hike'
	// Social
	| 'email'
	| 'linkedin'
	| 'github'
	| 'whatsapp';

interface Props {
	name: IconName;
	class?: string;
	strokeWidth?: number;
}

const { name, class: className = 'h-5 w-5', strokeWidth = 1.7 } = Astro.props;

