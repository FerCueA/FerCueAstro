};

const fill = fillIcons[name];
const stroke = strokeIcons[name];
---

{fill ? (
	<svg viewBox="0 0 20 20" fill="currentColor" class={className} aria-hidden="true">
		<path d={fill} />
	</svg>
) : (
	<svg
		viewBox={stroke?.viewBox ?? '0 0 24 24'}
		fill="none"
		stroke="currentColor"
		stroke-width={strokeWidth}
		class={className}
		aria-hidden="true"
	>
		<path d={stroke?.path ?? ''} stroke-linecap="round" stroke-linejoin="round" />
	</svg>
)}
