---
import { hubSections, profile } from '../../data/portfolio';
import CertificatesSection from '../sections/credentials/CertificatesSection.astro';
import ContactSection from '../sections/engagement/ContactSection.astro';
import ExperienceSection from '../sections/experience/ExperienceSection.astro';
import HeroSection from '../sections/profile/HeroSection.astro';
import ProjectsSection from '../sections/work/ProjectsSection.astro';
import ServicesSection from '../sections/services/ServicesSection.astro';
import TechnologiesSection from '../sections/expertise/TechnologiesSection.astro';
---

<div id="section-hub" class="mx-auto min-h-[calc(100vh-2rem)] max-w-[1100px]">
	<section
		id="front-hero"
		aria-label="Cabecera del portafolio"
		class="grid min-h-[calc(100vh-2rem)] place-content-center justify-items-center gap-6 border-b border-line px-2 py-8 transition-all duration-300 sm:gap-7"
	>
		<p class="text-xs font-medium uppercase tracking-[0.2em] text-ink-muted">Disponible para proyectos</p>

		<h1
			id="front-name"
			class="max-w-full text-center font-serif text-[clamp(1.9rem,6.2vw,5.1rem)] leading-[0.98] tracking-[-0.01em] text-ink transition-all duration-300 sm:whitespace-nowrap"
		>
			{profile.name}
		</h1>

		<p class="max-w-md text-center text-sm leading-6 text-ink-soft sm:text-base sm:leading-7">
			{profile.role} · diseño, desarrollo web y automatización.
		</p>

		<nav id="front-nav" aria-label="Secciones principales" class="flex w-full max-w-3xl flex-wrap justify-center gap-x-6 gap-y-2">
			{hubSections.map((section) => (
				<button
					type="button"
					class="menu-option group relative py-1 text-sm font-medium tracking-[0.01em] sm:text-base"
					data-target={section.id}
					data-label={section.label}
					aria-pressed="false"
				>
					<span>{section.label}</span>
					<span class="menu-option-line absolute -bottom-0.5 left-0 h-px w-full origin-left bg-gold-main" />
				</button>
			))}
		</nav>

		<p class="text-xs uppercase tracking-[0.18em] text-ink-muted">Elige una sección para empezar</p>
	</section>

	<section
		id="view-stage"
		aria-live="polite"
		aria-hidden="true"
		class="pointer-events-none mt-4 max-h-0 translate-y-4 overflow-hidden opacity-0 transition-all duration-300"
	>
		<div class="sticky top-0 z-10 -mx-1 flex items-center gap-2.5 bg-paper/85 px-1 py-4 backdrop-blur-sm">
			<span class="h-1.5 w-1.5 rounded-full bg-gold-main"></span>
			<p id="active-section-label" class="text-xs font-medium uppercase tracking-[0.18em] text-ink-soft">
				Selecciona una sección
			</p>
		</div>

		<div class="pt-2">
			<div class="view-panel animate-[fadeIn_280ms_ease]" data-panel="perfil" hidden>
				<HeroSection />
			</div>
			<div class="view-panel animate-[fadeIn_280ms_ease]" data-panel="experiencia" hidden>
				<ExperienceSection />
			</div>
			<div class="view-panel animate-[fadeIn_280ms_ease]" data-panel="proyectos" hidden>
				<ProjectsSection />
			</div>
			<div class="view-panel animate-[fadeIn_280ms_ease]" data-panel="servicios" hidden>
				<ServicesSection />
			</div>
			<div class="view-panel animate-[fadeIn_280ms_ease]" data-panel="tecnologias" hidden>
				<TechnologiesSection />
			</div>
			<div class="view-panel animate-[fadeIn_280ms_ease]" data-panel="certificados" hidden>
				<CertificatesSection />
			</div>
			<div class="view-panel animate-[fadeIn_280ms_ease]" data-panel="contacto" hidden>
				<ContactSection />
			</div>
		</div>
	</section>
</div>

<script>
	import { initializeViewState, updateView, runWithTransition } from '../../utils/viewTransitions';

	const viewState = initializeViewState();
	const { menuButtons } = viewState;

	menuButtons.forEach((button) => {
		button.addEventListener('click', () => {
			const target = button.dataset.target;
			if (!target) return;
			const isActive = button.getAttribute('aria-pressed') === 'true';
			runWithTransition(() => updateView(viewState, isActive ? '' : target));
		});
	});

	const quickAccessButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-open-section]'));
	quickAccessButtons.forEach((button) => {
		button.addEventListener('click', () => {
			const target = button.dataset.openSection;
			if (!target) return;
			runWithTransition(() => updateView(viewState, target));
		});
	});

	const revealTargets = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]'));
	if (revealTargets.length > 0 && 'IntersectionObserver' in window) {
		const revealObserver = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						entry.target.classList.add('is-visible');
						revealObserver.unobserve(entry.target);
					}
				});
			},
			{ threshold: 0.12, rootMargin: '0px 0px -40px 0px' },
		);

		revealTargets.forEach((target) => revealObserver.observe(target));
	} else {
		revealTargets.forEach((target) => target.classList.add('is-visible'));
	}

	updateView(viewState, '');
</script>
