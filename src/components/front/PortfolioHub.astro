---
import { hubSections, profile } from '../../data/portfolio';
import CertificatesSection from '../sections/credentials/CertificatesSection.astro';
import ContactSection from '../sections/engagement/ContactSection.astro';
import ExperienceSection from '../sections/experience/ExperienceSection.astro';
import HeroSection from '../sections/profile/HeroSection.astro';
import ProcessSection from '../sections/process/ProcessSection.astro';
import ProjectsSection from '../sections/work/ProjectsSection.astro';
import ServicesSection from '../sections/services/ServicesSection.astro';
import TechnologiesSection from '../sections/expertise/TechnologiesSection.astro';
---

<div id="section-hub" class="mx-auto min-h-[calc(100vh-2rem)] max-w-300">
	<section
		id="front-hero"
		aria-label="Cabecera del portafolio"
		class="relative grid min-h-[calc(100vh-2rem)] place-content-center justify-items-center gap-5 overflow-hidden rounded-4xl border border-ink/10 bg-paper/90 px-4 py-8 shadow-[0_10px_24px_rgba(17,20,35,0.07)] transition-all duration-300 sm:gap-6 sm:px-8 sm:py-8 sm:shadow-[0_20px_46px_rgba(17,20,35,0.09)] sm:duration-500"
	>
		<div aria-hidden="true" class="grid-pattern pointer-events-none absolute inset-0 opacity-60"></div>
		<div
			aria-hidden="true"
			class="animate-float-slow pointer-events-none absolute -left-20 -top-24 h-64 w-64 rounded-full bg-gold-main/20 blur-3xl"
		></div>
		<div
			aria-hidden="true"
			class="pointer-events-none absolute -right-16 bottom-[-3rem] h-72 w-72 rounded-full bg-violet-main/20 blur-3xl"
		></div>

		<p class="relative inline-flex items-center gap-2 rounded-full border border-gold-main/30 bg-gold-main/10 px-4 py-1.5 text-[0.62rem] font-semibold uppercase tracking-[0.22em] text-violet-deep sm:text-xs">
			<span class="h-1.5 w-1.5 rounded-full bg-gold-main"></span>
			Disponible para proyectos
		</p>

		<h1
			id="front-name"
			class="relative max-w-full text-center font-serif text-[clamp(1.9rem,6.2vw,5.1rem)] leading-none tracking-[0.01em] text-ink transition-all duration-300 sm:whitespace-nowrap"
		>
			{profile.name}
		</h1>

		<p class="relative max-w-xl text-center text-sm leading-6 text-ink/62 sm:text-base sm:leading-7">
			{profile.role} · diseño, desarrollo y automatización con foco en resultados.
		</p>
		<nav
			id="front-nav"
			aria-label="Secciones principales"
			class="flex w-full max-w-225 flex-wrap justify-center gap-x-4 gap-y-2.5 sm:gap-x-6 sm:gap-y-3"
		>
			{hubSections.map((section) => (
				<button
					type="button"
					class="menu-option group relative rounded-full px-2 py-1 text-[clamp(0.88rem,3.6vw,1.02rem)] font-semibold tracking-[0.01em] text-ink/70 transition-colors duration-200 hover:text-ink"
					data-target={section.id}
					data-label={section.label}
					aria-pressed="false"
				>
					<span>{section.label}</span>
					<span class="menu-option-line absolute bottom-0 left-0 h-[1.5px] w-full origin-left scale-x-0 bg-[linear-gradient(90deg,rgba(201,155,69,0.92),rgba(95,75,120,0.82))] transition-transform duration-200"></span>
				</button>
			))}
		</nav>

		<p class="relative text-[0.66rem] uppercase tracking-[0.18em] text-ink/40 sm:text-xs">Elige una sección para empezar</p>
	</section>

	<section
		id="view-stage"
		aria-live="polite"
		aria-hidden="true"
		class="pointer-events-none mt-3 max-h-0 translate-y-4 overflow-hidden opacity-0 transition-all duration-300 sm:mt-4"
	>
		<div class="sticky top-2 z-10 flex flex-wrap items-center justify-between gap-2 rounded-2xl border border-ink/10 bg-paper/95 p-2.5 sm:flex-nowrap sm:gap-3 sm:bg-paper/90 sm:p-3 sm:backdrop-blur-sm">
			<button
				id="back-to-menu"
				type="button"
				class="rounded-full border border-ink/15 bg-surface px-3.5 py-2 text-[0.62rem] font-bold uppercase tracking-[0.14em] text-ink/80 transition hover:border-gold-main/40 hover:bg-gold-main/10 sm:px-4 sm:text-[0.68rem] sm:tracking-[0.16em]"
			>
				Volver al menú
			</button>
			<p
				id="active-section-label"
				class="text-[0.66rem] font-bold uppercase tracking-[0.14em] text-ink/55 sm:text-[0.72rem] sm:tracking-[0.2em]"
			>
				Selecciona una sección
			</p>
		</div>

		<div class="pt-3">
			<div class="view-panel animate-[fadeIn_280ms_ease]" data-panel="perfil" hidden>
				<HeroSection />
			</div>
			<div class="view-panel animate-[fadeIn_280ms_ease]" data-panel="experiencia" hidden>
				<ExperienceSection />
			</div>
			<div class="view-panel animate-[fadeIn_280ms_ease]" data-panel="proyectos" hidden>
				<ProjectsSection />
			</div>
			<div class="view-panel animate-[fadeIn_280ms_ease]" data-panel="servicios" hidden>
				<ServicesSection />
			</div>
			<div class="view-panel animate-[fadeIn_280ms_ease]" data-panel="tecnologias" hidden>
				<TechnologiesSection />
			</div>
			<div class="view-panel animate-[fadeIn_280ms_ease]" data-panel="proceso" hidden>
				<ProcessSection />
			</div>
			<div class="view-panel animate-[fadeIn_280ms_ease]" data-panel="certificados" hidden>
				<CertificatesSection />
			</div>
			<div class="view-panel animate-[fadeIn_280ms_ease]" data-panel="contacto" hidden>
				<ContactSection />
			</div>
		</div>
	</section>
</div>

<script>
	import { initializeViewState, updateView, runWithTransition } from '../../utils/viewTransitions';

	const viewState = initializeViewState();
	const { menuButtons, backButton } = viewState;

	// Setup menu button event listeners
	menuButtons.forEach((button) => {
		button.addEventListener('click', () => {
			const target = button.dataset.target;
			if (!target) return;
			runWithTransition(() => updateView(viewState, target));
		});
	});

	// Setup quick access buttons inside panels (e.g., Perfil CTAs)
	const quickAccessButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-open-section]'));
	quickAccessButtons.forEach((button) => {
		button.addEventListener('click', () => {
			const target = button.dataset.openSection;
			if (!target) return;
			runWithTransition(() => updateView(viewState, target));
		});
	});

	// Setup back button event listener
	backButton?.addEventListener('click', () => {
		runWithTransition(() => updateView(viewState, ''));
	});

	// Reveal sections on scroll as they enter the viewport
	const revealTargets = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]'));
	if (revealTargets.length > 0 && 'IntersectionObserver' in window) {
		const revealObserver = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						entry.target.classList.add('is-visible');
						revealObserver.unobserve(entry.target);
					}
				});
			},
			{ threshold: 0.12, rootMargin: '0px 0px -40px 0px' },
		);

		revealTargets.forEach((target) => revealObserver.observe(target));
	} else {
		revealTargets.forEach((target) => target.classList.add('is-visible'));
	}

	// Initialize with closed view
	updateView(viewState, '');
</script>
