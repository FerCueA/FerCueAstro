---
import { experiences } from '../../../data/portfolio';
import SectionIntro from '../../ui/SectionIntro.astro';

const currentCount = experiences.filter((experience) => experience.current).length;
---

<section id="experiencia" class="py-10 sm:py-12 lg:py-16">
	<div class="rounded-4xl border border-ink/8 bg-surface/90 p-5 shadow-sm shadow-black/5 sm:bg-surface/88 sm:p-8 sm:backdrop-blur-xl">
		<div class="mb-7 flex flex-col gap-4 sm:mb-9 sm:gap-5 lg:flex-row lg:items-end lg:justify-between">
			<div class="lg:max-w-3xl">
				<SectionIntro
					index="01"
					kicker="Experiencia"
					title="Trayectoria profesional"
					description="De la web de cliente a la automatización de procesos: experiencia combinando producto, negocio y herramientas empresariales."
				/>
			</div>
			<div class="flex flex-wrap items-center gap-2.5 sm:gap-3 lg:pb-8">
				<span class="rounded-full border border-gold-main/20 bg-gold-main/10 px-3 py-1.5 text-[0.68rem] font-medium uppercase tracking-[0.14em] text-violet-deep sm:px-4 sm:py-2 sm:text-xs sm:tracking-[0.22em]">
					{experiences.length} etapas
				</span>
				{currentCount > 0 && (
					<span class="rounded-full border border-violet-main/20 bg-violet-soft/35 px-3 py-1.5 text-[0.68rem] font-medium uppercase tracking-[0.14em] text-violet-deep sm:px-4 sm:py-2 sm:text-xs sm:tracking-[0.22em]">
						Actualidad
					</span>
				)}
			</div>
		</div>

		<ol class="relative space-y-6 sm:space-y-8">
			<span
				aria-hidden="true"
				class="absolute bottom-2 left-[15px] top-2 w-px bg-linear-to-b from-gold-main/60 via-violet-main/40 to-transparent sm:left-[19px]"
			></span>
			{experiences.map((experience, index) => (
				<li class="relative pl-10 sm:pl-14" data-reveal style={`animation-delay:${index * 90}ms`}>
					<span
						class:list={[
							'absolute left-0 top-1 flex h-8 w-8 items-center justify-center rounded-full border text-[0.7rem] font-bold sm:h-10 sm:w-10 sm:text-xs',
							experience.current ? 'animate-pulse-dot border-gold-main/40 bg-gold-main text-ink' : 'border-ink/12 bg-paper text-ink/60',
						]}
					>
						{index + 1}
					</span>
					<article class="group rounded-3xl border border-ink/8 bg-paper/85 p-4 shadow-sm shadow-black/5 transition duration-300 hover:-translate-y-0.5 hover:border-gold-main/30 hover:shadow-lg hover:shadow-black/8 sm:p-6">
						<div class="flex flex-wrap items-start justify-between gap-3">
							<div>
								<h3 class="text-lg font-semibold text-ink sm:text-xl">{experience.role}</h3>
								<p class="mt-1 text-sm font-medium text-violet-deep sm:text-base">{experience.company}</p>
								{experience.location && <p class="mt-0.5 text-xs text-ink/55 sm:text-sm">{experience.location}</p>}
							</div>
							<div class="flex flex-wrap items-center gap-2">
								{experience.current && (
									<span class="inline-flex items-center gap-1.5 rounded-full border border-gold-main/25 bg-gold-main/10 px-3 py-1 text-[0.62rem] font-semibold uppercase tracking-[0.14em] text-violet-deep">
										<span class="h-1.5 w-1.5 rounded-full bg-gold-main" />
										Actual
									</span>
								)}
								<span class="rounded-full border border-ink/10 bg-surface px-3 py-1 text-[0.62rem] font-semibold uppercase tracking-[0.14em] text-ink/60">
									{experience.period}
								</span>
							</div>
						</div>

						<p class="mt-3 text-sm leading-6 text-ink/70 sm:mt-4 sm:text-base sm:leading-7">{experience.description}</p>

						<ul class="mt-4 space-y-2 sm:mt-5">
							{experience.achievements.map((achievement) => (
								<li class="flex gap-2.5 text-sm leading-6 text-ink/72">
									<svg viewBox="0 0 20 20" fill="none" class="mt-0.5 h-4 w-4 shrink-0 text-gold-main" aria-hidden="true">
										<path
											d="m4.5 10.5 3.2 3.2 7.8-8"
											stroke="currentColor"
											stroke-width="1.8"
											stroke-linecap="round"
											stroke-linejoin="round"
										/>
									</svg>
									<span>{achievement}</span>
								</li>
							))}
						</ul>

						<div class="mt-4 flex flex-wrap gap-2 sm:mt-5">
							{experience.stack.map((item) => (
								<span class="rounded-full border border-violet-main/16 bg-violet-soft/35 px-3 py-1 text-xs font-medium text-violet-deep sm:text-sm">
									{item}
								</span>
							))}
						</div>
					</article>
				</li>
			))}
		</ol>
	</div>
</section>
