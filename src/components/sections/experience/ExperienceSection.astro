---
import { experiences } from '../../../data/portfolio';
import SectionShell from '../../ui/SectionShell.astro';
import Tag from '../../ui/Tag.astro';

const currentCount = experiences.filter((experience) => experience.current).length;
const meta = [`${experiences.length} etapas`, currentCount > 0 ? 'Actualmente en activo' : ''].filter(Boolean);
---

<SectionShell
	id="experiencia"
	index="01"
	kicker="Experiencia"
	title="Trayectoria profesional"
	description="De la web de cliente a la automatización de procesos: producto, negocio y herramientas empresariales."
	meta={meta}
>
	<ol>
		{experiences.map((experience, index) => (
			<li
				class="grid gap-x-10 gap-y-4 border-t border-line py-9 first:border-t-0 first:pt-0 sm:grid-cols-[11rem_1fr]"
				data-reveal
				style={`animation-delay:${index * 80}ms`}
			>
				<div>
					<p class="text-xs uppercase tracking-[0.16em] text-ink-muted">{experience.period}</p>
					{experience.location && <p class="mt-1 text-sm text-ink-muted">{experience.location}</p>}
					{experience.current && (
						<p class="mt-2 inline-flex items-center gap-2 text-xs font-medium text-gold-main">
							<span class="animate-pulse-dot h-1.5 w-1.5 rounded-full bg-gold-main" />
							Actual
						</p>
					)}
				</div>

				<div>
					<h3 class="font-serif text-xl leading-snug text-ink sm:text-2xl">{experience.role}</h3>
					<p class="mt-1 text-sm font-medium text-violet-deep">{experience.company}</p>
					<p class="mt-3 max-w-2xl text-sm leading-6 text-ink-soft sm:text-base sm:leading-7">{experience.description}</p>

					<ul class="mt-4 space-y-1.5">
						{experience.achievements.map((achievement) => (
							<li class="flex gap-3 text-sm leading-6 text-ink-soft">
								<span class="mt-2.5 h-1 w-1 shrink-0 rounded-full bg-gold-main" />
								{achievement}
							</li>
						))}
					</ul>

					<div class="mt-4 flex flex-wrap gap-1.5">
						{experience.stack.map((item) => (
							<Tag>{item}</Tag>
						))}
					</div>
				</div>
			</li>
		))}
	</ol>
</SectionShell>
