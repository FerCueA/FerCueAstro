---
import { skillGroups } from '../../../data/portfolio';
import Icon from '../../ui/Icon.astro';
import SectionShell from '../../ui/SectionShell.astro';
import Tag from '../../ui/Tag.astro';

const totalItems = skillGroups.reduce((acc, group) => acc + group.items.length, 0);
---

<SectionShell
	id="tecnologias"
	index="04"
	kicker="Tecnologías"
	title="Stack y herramientas"
	description="No es una lista de tendencias: es lo que uso para entregar proyectos rápidos, mantenibles y bien acabados."
	meta={[`${skillGroups.length} bloques`, `${totalItems} herramientas`]}
>
	<div class="grid gap-x-12 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
		{skillGroups.map((group, index) => (
			<div data-reveal style={`animation-delay:${index * 50}ms`}>
				<div class="flex items-center gap-2.5 border-b border-line pb-3">
					<Icon name={group.icon} class="h-4 w-4 text-gold-main" />
					<h3 class="text-sm font-semibold text-ink">{group.title}</h3>
				</div>
				<p class="mt-3 text-sm leading-6 text-ink-muted">{group.description}</p>
				<ul class="mt-3 flex flex-wrap gap-1.5">
					{group.items.map((item) => (
						<li>
							<Tag>{item}</Tag>
						</li>
					))}
				</ul>
			</div>
		))}
	</div>
</SectionShell>
