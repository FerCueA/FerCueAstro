---
import { skillGroups } from '../../../data/portfolio';
import Badge from '../../ui/Badge.astro';
import Icon from '../../ui/Icon.astro';
import SectionShell from '../../ui/SectionShell.astro';
import Tag from '../../ui/Tag.astro';

const totalItems = skillGroups.reduce((acc, group) => acc + group.items.length, 0);
const allItems = skillGroups.flatMap((group) => group.items);
---

<SectionShell
	id="tecnologias"
	index="04"
	kicker="Tecnologías"
	title="Stack, plataformas y herramientas"
	description="El stack que uso no es tendencia: es lo que me permite entregar proyectos rápidos, mantenibles y bien acabados."
>
	<Badge slot="badges" variant="gold">
		{skillGroups.length} bloques
	</Badge>
	<Badge slot="badges" variant="violet">
		{totalItems} herramientas
	</Badge>

	<div
		class="relative mb-6 overflow-hidden rounded-inner border border-ink/8 bg-paper/70 py-3.5 sm:mb-8 [mask-image:linear-gradient(90deg,transparent,black_8%,black_92%,transparent)]"
		aria-hidden="true"
	>
		<div class="animate-marquee flex w-max gap-3">
			{[...allItems, ...allItems].map((item) => (
				<Tag>{item}</Tag>
			))}
		</div>
	</div>

	<div class="grid gap-4 sm:grid-cols-2 sm:gap-5 lg:grid-cols-3">
		{skillGroups.map((group, index) => (
			<article
				class="flex flex-col rounded-card border border-ink/8 bg-paper/85 p-4 shadow-soft transition duration-300 hover:-translate-y-0.5 hover:border-gold-main/30 hover:shadow-lift sm:p-6"
				data-reveal
				style={`animation-delay:${index * 70}ms`}
			>
				<div class="flex items-start gap-4">
					<div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-inner border border-gold-main/20 bg-gold-main/10 text-gold-soft">
						<Icon name={group.icon} class="h-6 w-6" />
					</div>
					<div>
						<p class="text-[0.72rem] uppercase tracking-[0.16em] text-gold-soft sm:text-sm sm:tracking-[0.22em]">{group.title}</p>
						<p class="mt-1 text-sm leading-6 text-ink/60">{group.description}</p>
					</div>
				</div>

				<ul class="mt-4 grid grid-cols-2 gap-2.5 sm:grid-cols-3 sm:gap-3">
					{group.items.map((item) => (
						<li>
							<Tag shape="soft" class="w-full justify-center">
								{item}
							</Tag>
						</li>
					))}
				</ul>
			</article>
		))}
	</div>
</SectionShell>
