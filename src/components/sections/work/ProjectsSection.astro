---
import { projects } from '../../../data/portfolio';
import Badge from '../../ui/Badge.astro';
import Button from '../../ui/Button.astro';
import Icon from '../../ui/Icon.astro';
import SectionShell from '../../ui/SectionShell.astro';
import Tag from '../../ui/Tag.astro';

const stackCount = new Set(projects.flatMap((project) => project.stack)).size;

const toDomain = (url?: string) => (url ? url.replace(/^https?:\/\//, '').replace(/\/$/, '') : 'en desarrollo');
---

<SectionShell
	id="proyectos"
	index="02"
	kicker="Proyectos"
	title="Proyectos seleccionados"
	description="Cada proyecto resolvió un problema concreto: visibilidad, conversión o una base técnica más sólida."
	meta={[`${projects.length} proyectos`, `${stackCount} tecnologías`]}
>
	<div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
		{projects.map((project, index) => (
			<article
				class="group flex h-full flex-col overflow-hidden rounded-card border border-line bg-surface transition duration-300 hover:-translate-y-1 hover:shadow-lift"
				data-reveal
				style={`animation-delay:${index * 70}ms`}
			>
				<div class="relative flex h-40 items-center justify-center overflow-hidden border-b border-line bg-surface-muted px-4">
					<div class="w-full max-w-[15rem] rounded-t-inner border border-line bg-surface shadow-soft transition duration-500 group-hover:-translate-y-1">
						<div class="flex items-center gap-1.5 border-b border-line px-3 py-2">
							<span class="h-2 w-2 rounded-full bg-line"></span>
							<span class="h-2 w-2 rounded-full bg-line"></span>
							<span class="h-2 w-2 rounded-full bg-line"></span>
							<span class="ml-1.5 truncate text-[0.62rem] text-ink-muted">{toDomain(project.liveUrl)}</span>
						</div>
						<div class="flex flex-col gap-2 p-3">
							<span class="h-2 w-2/3 rounded-full bg-gold-main/40"></span>
							<span class="h-2 w-1/2 rounded-full bg-violet-main/25"></span>
							<span class="mt-1 h-6 rounded-sm bg-surface-muted"></span>
						</div>
					</div>
					<Badge class="absolute right-3 top-3">{project.status}</Badge>
				</div>

				<div class="flex flex-1 flex-col p-5">
					<p class="text-xs uppercase tracking-[0.16em] text-ink-muted">{project.category}</p>
					<h3 class="mt-2 font-serif text-xl text-ink">{project.title}</h3>
					<p class="mt-3 text-sm leading-6 text-ink-soft">{project.description}</p>
					<p class="mt-3 text-sm leading-6 text-ink-muted">{project.outcome}</p>

					<div class="mt-4 flex flex-wrap gap-1.5">
						{project.stack.map((item) => (
							<Tag>{item}</Tag>
						))}
					</div>

					<div class="mt-auto flex flex-wrap items-center gap-4 pt-6">
						{project.liveUrl && <Button href={project.liveUrl}>Ver proyecto</Button>}
						<Button href={project.repoUrl} variant="ghost">
							Ver código
							<Icon name="arrowRight" class="h-4 w-4" strokeWidth={1.6} />
						</Button>
					</div>
				</div>
			</article>
		))}
	</div>
</SectionShell>
