---
import { projects } from '../../../data/portfolio';
import SectionIntro from '../../ui/SectionIntro.astro';

const stackCount = new Set(projects.flatMap((project) => project.stack)).size;

const toDomain = (url?: string) => (url ? url.replace(/^https?:\/\//, '').replace(/\/$/, '') : 'en desarrollo');
---

<section id="proyectos" class="py-10 sm:py-12 lg:py-16">
	<div class="rounded-4xl border border-ink/8 bg-surface/90 p-5 shadow-sm shadow-black/5 sm:bg-surface/88 sm:p-8 sm:backdrop-blur-xl">
		<div class="mb-6 flex flex-col gap-4 sm:mb-8 sm:gap-5 lg:flex-row lg:items-end lg:justify-between">
			<div class="lg:max-w-3xl">
				<SectionIntro
					index="02"
					kicker="Proyectos"
					title="Proyectos seleccionados"
					description="Cada proyecto resolvió un problema concreto: más visibilidad, mejor conversión o una base técnica más sólida. Código real, resultados medibles."
				/>
			</div>
			<div class="flex flex-wrap items-center gap-2.5 sm:gap-3 lg:pb-8">
				<span class="rounded-full border border-gold-main/20 bg-gold-main/10 px-3 py-1.5 text-[0.68rem] font-medium uppercase tracking-[0.14em] text-violet-deep sm:px-4 sm:py-2 sm:text-xs sm:tracking-[0.22em]">
					{projects.length} proyectos
				</span>
				<span class="rounded-full border border-violet-main/20 bg-violet-soft/35 px-3 py-1.5 text-[0.68rem] font-medium uppercase tracking-[0.14em] text-violet-deep sm:px-4 sm:py-2 sm:text-xs sm:tracking-[0.22em]">
					{stackCount} tecnologías
				</span>
			</div>
		</div>

		<div class="grid gap-5 sm:gap-6 md:grid-cols-2 xl:grid-cols-3">
			{projects.map((project, index) => (
				<article
					class="group flex h-full flex-col overflow-hidden rounded-[1.75rem] border border-ink/8 bg-surface/90 shadow-sm shadow-black/5 transition duration-300 hover:-translate-y-1 hover:border-gold-main/30 hover:shadow-xl hover:shadow-black/8"
					data-reveal
					style={`animation-delay:${index * 80}ms`}
				>
					<div class="relative h-44 overflow-hidden border-b border-ink/8 bg-linear-to-br from-violet-soft/45 via-surface to-gold-soft/35 p-4">
						<div aria-hidden="true" class="grid-pattern pointer-events-none absolute inset-0 opacity-50"></div>
						<div class="relative mx-auto flex h-full w-full max-w-[15rem] flex-col rounded-t-2xl border border-ink/10 bg-paper shadow-lg shadow-black/10 transition duration-500 group-hover:-translate-y-1">
							<div class="flex items-center gap-1.5 border-b border-ink/8 px-3 py-2">
								<span class="h-2 w-2 rounded-full bg-[#ff5f57]"></span>
								<span class="h-2 w-2 rounded-full bg-[#febc2e]"></span>
								<span class="h-2 w-2 rounded-full bg-[#28c840]"></span>
								<span class="ml-1.5 truncate rounded-full bg-ink/5 px-2 py-0.5 text-[0.58rem] text-ink/45">
									{toDomain(project.liveUrl)}
								</span>
							</div>
							<div class="flex flex-1 flex-col gap-2 p-3">
								<span class="h-2.5 w-2/3 rounded-full bg-gold-main/70"></span>
								<span class="h-2 w-1/2 rounded-full bg-violet-main/30"></span>
								<div class="mt-auto grid grid-cols-3 gap-1.5">
									<span class="h-7 rounded-md bg-violet-soft/55"></span>
									<span class="h-7 rounded-md bg-gold-soft/60"></span>
									<span class="h-7 rounded-md bg-violet-soft/55"></span>
								</div>
							</div>
						</div>
						<span class="absolute right-3.5 top-3.5 rounded-full border border-gold-main/30 bg-gold-main/15 px-2.5 py-1 text-[0.58rem] font-semibold uppercase tracking-[0.16em] text-violet-deep backdrop-blur-sm">
							{project.status}
						</span>
					</div>

					<div class="flex flex-1 flex-col p-5">
						<p class="text-[0.64rem] uppercase tracking-[0.2em] text-violet-deep">{project.category}</p>
						<h3 class="mt-2 text-xl font-semibold text-ink">{project.title}</h3>
						<p class="mt-3 text-sm leading-6 text-ink/70">{project.description}</p>
						<p class="mt-3.5 rounded-2xl border border-ink/8 bg-paper/80 px-3.5 py-2.5 text-xs leading-5 text-ink/70">{project.outcome}</p>

						<div class="mt-4 flex flex-wrap gap-2">
							{project.stack.map((item) => (
								<span class="rounded-full border border-violet-main/16 bg-violet-soft/35 px-2.5 py-1 text-xs font-medium text-violet-deep">
									{item}
								</span>
							))}
						</div>

						<div class="mt-auto pt-5 flex flex-wrap gap-2.5">
							{project.liveUrl && (
								<a
									href={project.liveUrl}
									target="_blank"
									rel="noreferrer"
									class="inline-flex flex-1 justify-center rounded-full bg-gold-main px-4 py-2 text-sm font-semibold text-ink transition hover:bg-gold-soft"
								>
									Ver proyecto
								</a>
							)}
							<a
								href={project.repoUrl}
								target="_blank"
								rel="noreferrer"
								class="inline-flex flex-1 justify-center rounded-full border border-ink/10 bg-paper px-4 py-2 text-sm font-semibold text-ink transition hover:border-gold-main/35 hover:bg-surface"
							>
								Ver código
							</a>
						</div>
					</div>
				</article>
			))}
		</div>
	</div>
</section>
