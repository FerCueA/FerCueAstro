---
import { projects } from '../../../data/portfolio';
import Badge from '../../ui/Badge.astro';
import Button from '../../ui/Button.astro';
import SectionShell from '../../ui/SectionShell.astro';

const stackCount = new Set(projects.flatMap((project) => project.stack)).size;

const toDomain = (url?: string) => (url ? url.replace(/^https?:\/\//, '').replace(/\/$/, '') : 'en desarrollo');
---

<SectionShell
	id="proyectos"
	index="02"
	kicker="Proyectos"
	title="Proyectos seleccionados"
	description="Cada proyecto resolvió un problema concreto: más visibilidad, mejor conversión o una base técnica más sólida. Código real, resultados medibles."
>
	<Badge slot="badges" variant="gold">
		{projects.length} proyectos
	</Badge>
	<Badge slot="badges" variant="violet">
		{stackCount} tecnologías
	</Badge>

	<div class="grid gap-5 sm:gap-6 md:grid-cols-2 xl:grid-cols-3">
		{projects.map((project, index) => (
			<article
				class="group flex h-full flex-col overflow-hidden rounded-card border border-ink/8 bg-surface/90 shadow-soft transition duration-300 hover:-translate-y-1 hover:border-gold-main/30 hover:shadow-lift"
				data-reveal
				style={`animation-delay:${index * 80}ms`}
			>
				<div class="relative h-44 overflow-hidden border-b border-ink/8 bg-linear-to-br from-violet-soft/45 via-surface to-gold-soft/35 p-4">
					<div aria-hidden="true" class="grid-pattern pointer-events-none absolute inset-0 opacity-50" />
					<div class="relative mx-auto flex h-full w-full max-w-[15rem] flex-col rounded-t-inner border border-ink/10 bg-paper shadow-lift transition duration-500 group-hover:-translate-y-1">
						<div class="flex items-center gap-1.5 border-b border-ink/8 px-3 py-2">
							<span class="h-2 w-2 rounded-full bg-[#ff5f57]"></span>
							<span class="h-2 w-2 rounded-full bg-[#febc2e]"></span>
							<span class="h-2 w-2 rounded-full bg-[#28c840]"></span>
							<span class="ml-1.5 truncate rounded-full bg-ink/5 px-2 py-0.5 text-[0.58rem] text-ink/45">{toDomain(project.liveUrl)}</span>
						</div>
						<div class="flex flex-1 flex-col gap-2 p-3">
							<span class="h-2.5 w-2/3 rounded-full bg-gold-main/70"></span>
							<span class="h-2 w-1/2 rounded-full bg-violet-main/30"></span>
							<div class="mt-auto grid grid-cols-3 gap-1.5">
								<span class="h-7 rounded-md bg-violet-soft/55"></span>
								<span class="h-7 rounded-md bg-gold-soft/60"></span>
								<span class="h-7 rounded-md bg-violet-soft/55"></span>
							</div>
						</div>
					</div>
					<Badge variant="gold" size="sm" class="absolute right-3.5 top-3.5 backdrop-blur-sm">
						{project.status}
					</Badge>
				</div>

				<div class="flex flex-1 flex-col p-5">
					<p class="text-[0.64rem] uppercase tracking-[0.2em] text-violet-deep">{project.category}</p>
					<h3 class="mt-2 text-xl font-semibold text-ink">{project.title}</h3>
					<p class="mt-3 text-sm leading-6 text-ink/70">{project.description}</p>
					<p class="mt-3.5 rounded-inner border border-ink/8 bg-paper/80 px-3.5 py-2.5 text-xs leading-5 text-ink/70">{project.outcome}</p>

					<div class="mt-4 flex flex-wrap gap-2">
						{project.stack.map((item) => (
							<span class="rounded-full border border-violet-main/16 bg-violet-soft/35 px-2.5 py-1 text-xs font-medium text-violet-deep">
								{item}
							</span>
						))}
					</div>

					<div class="mt-auto flex flex-wrap gap-2.5 pt-5">
						{project.liveUrl && (
							<Button href={project.liveUrl} class="flex-1">
								Ver proyecto
							</Button>
						)}
						<Button href={project.repoUrl} variant="secondary" class="flex-1">
							Ver código
						</Button>
					</div>
				</div>
			</article>
		))}
	</div>
</SectionShell>
