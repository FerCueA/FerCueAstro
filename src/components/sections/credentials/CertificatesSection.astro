---
import { certificates } from '../../../data/portfolio';
import type { Certificate as PortfolioCertificate } from '../../../data/portfolio';
import Button from '../../ui/Button.astro';
import Icon from '../../ui/Icon.astro';
import SectionShell from '../../ui/SectionShell.astro';

const recommendation = certificates.find((certificate: PortfolioCertificate) => certificate.category === 'Recomendaciones');
const otherCertificates = certificates.filter((certificate: PortfolioCertificate) => certificate.category !== 'Recomendaciones');

const certificateCategories = ['Todos', ...new Set(otherCertificates.map((certificate: PortfolioCertificate) => certificate.category))];

const categoryCount = certificateCategories.length - 1;
---

<SectionShell
	id="certificados"
	index="05"
	kicker="Certificados"
	title="Credenciales y formación"
	description="Frontend, JavaScript, backend con Java y Spring, bases de datos y herramientas de desarrollo."
	meta={[`${certificates.length} credenciales`, `${categoryCount} categorías`]}
>
	<div slot="under-intro" class="mt-6 flex flex-wrap gap-x-5 gap-y-2" data-certificate-filters>
		{certificateCategories.map((category, index) => (
			<button type="button" data-filter={category} class:list={['certificate-filter text-sm', index === 0 && 'is-active']}>
				{category}
			</button>
		))}
	</div>

	{recommendation && (
		<div class="mb-12 border-l-2 border-gold-main pl-5 sm:pl-6" data-reveal>
			<p class="text-xs font-medium uppercase tracking-[0.18em] text-gold-main">Recomendación</p>
			<h3 class="mt-2 font-serif text-2xl leading-tight text-ink sm:text-3xl">{recommendation.title}</h3>
			<p class="mt-1 text-sm text-ink-muted">{recommendation.issuer}</p>
			<Button href={encodeURI(recommendation.href)} variant="ghost" class="mt-3">
				Ver carta de recomendación
				<Icon name="arrowRight" class="h-4 w-4" strokeWidth={1.6} />
			</Button>
		</div>
	)}

	{otherCertificates.length > 0 ? (
		<ul class="grid gap-x-12 sm:grid-cols-2" data-certificate-grid>
			{otherCertificates.map((certificate: PortfolioCertificate, index: number) => (
				<li data-certificate-card data-category={certificate.category} data-reveal style={`animation-delay:${Math.min(index, 10) * 30}ms`}>
					<a
						href={encodeURI(certificate.href)}
						target="_blank"
						rel="noreferrer"
						class="group flex items-baseline justify-between gap-4 border-b border-line py-4"
					>
						<span>
							<span class="block text-xs uppercase tracking-[0.14em] text-ink-muted">{certificate.category}</span>
							<span class="mt-1 block text-sm font-medium text-ink sm:text-base">{certificate.title}</span>
						</span>
						<span class="shrink-0 text-ink-muted transition-colors group-hover:text-gold-main">
							<Icon name="arrowRight" class="h-4 w-4" strokeWidth={1.6} />
						</span>
					</a>
				</li>
			))}
		</ul>
	) : (
		<p class="text-ink-soft">No se encontraron PDFs en la carpeta pública de certificados.</p>
	)}
</SectionShell>

<script>
	const filterGroups = document.querySelectorAll('[data-certificate-filters]');

	filterGroups.forEach((group) => {
		const section = group.closest('section');
		const cards = Array.from(section?.querySelectorAll('[data-certificate-card]') ?? []);
		const buttons = Array.from(group.querySelectorAll('[data-filter]'));

		buttons.forEach((button) => {
			button.addEventListener('click', () => {
				const selectedCategory = button.getAttribute('data-filter') ?? 'Todos';

				buttons.forEach((currentButton) => {
					currentButton.classList.toggle('is-active', currentButton === button);
				});

				cards.forEach((card) => {
					const matches = selectedCategory === 'Todos' || card.getAttribute('data-category') === selectedCategory;
					card.toggleAttribute('hidden', !matches);
				});
			});
		});
	});
</script>
