---
import { services } from '../../../data/portfolio';
import type { Service } from '../../../data/portfolio';
import Button from '../../ui/Button.astro';
import Icon from '../../ui/Icon.astro';
import SectionShell from '../../ui/SectionShell.astro';

const featuredServices = services.filter((service) => service.featured).length;
---

<SectionShell
	id="servicios"
	index="03"
	kicker="Servicios"
	title="En qué puedo ayudarte"
	description="Cuatro enfoques según lo que necesitas ahora: desde lanzar tu primera web hasta refinar un producto que ya existe."
	meta={[`${services.length} servicios`, `${featuredServices} destacados`]}
>
	<ul class="border-t border-line">
		{services.map((service: Service, index: number) => {
			const whatsappMessage = `${service.inquiry} [Servicio: ${service.title}]`;

			return (
				<li
					class="grid gap-x-12 gap-y-3 border-b border-line py-9 sm:grid-cols-[2.5rem_1fr_auto] sm:items-baseline"
					data-reveal
					style={`animation-delay:${index * 60}ms`}
				>
					<span class="font-serif text-sm text-gold-main" aria-hidden="true">
						{String(index + 1).padStart(2, '0')}
					</span>

					<div>
						<div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
							<h3 class="font-serif text-xl text-ink sm:text-2xl">{service.title}</h3>
							{service.featured && <span class="text-xs uppercase tracking-[0.16em] text-gold-main">Más solicitado</span>}
						</div>
						<p class="mt-2 max-w-xl text-sm leading-6 text-ink-soft sm:text-base sm:leading-7">{service.description}</p>
					</div>

					<Button href={`https://wa.me/34628230716?text=${encodeURIComponent(whatsappMessage)}`} variant="ghost" class="sm:pt-1">
						{service.cta}
						<Icon name="arrowRight" class="h-4 w-4" strokeWidth={1.6} />
					</Button>
				</li>
			);
		})}
	</ul>
</SectionShell>
