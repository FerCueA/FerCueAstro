---
import { services } from '../../../data/portfolio';
import type { Service } from '../../../data/portfolio';
import Badge from '../../ui/Badge.astro';
import Button from '../../ui/Button.astro';
import Icon from '../../ui/Icon.astro';
import SectionShell from '../../ui/SectionShell.astro';

const featuredServices = services.filter((service) => service.featured).length;
---

<SectionShell
	id="servicios"
	index="03"
	kicker="Servicios"
	title="Servicios enfocados en presencia y producto"
	description="Cuatro enfoques según lo que necesitas ahora: desde lanzar tu primera web hasta refinar un producto que ya existe."
>
	<Badge slot="badges" variant="gold">
		{services.length} servicios
	</Badge>
	<Badge slot="badges" variant="violet">
		{featuredServices} destacados
	</Badge>

	<div class="grid gap-3.5 sm:grid-cols-2 sm:gap-4 lg:grid-cols-12">
		{services.map((service: Service, index: number) => {
			const whatsappMessage = `${service.inquiry} [Servicio: ${service.title}]`;

			return (
				<article
					class:list={[
						'relative flex h-full flex-col overflow-hidden rounded-card border p-4 shadow-soft transition duration-300 hover:-translate-y-0.5 hover:border-gold-main/30 hover:shadow-lift sm:p-5',
						index === 0 ? 'sm:col-span-2 lg:col-span-7' : index === 1 ? 'sm:col-span-2 lg:col-span-5' : 'lg:col-span-6',
						service.featured
							? 'border-gold-main/20 bg-linear-to-br from-gold-main/12 via-surface/95 to-violet-soft/18'
							: 'border-ink/8 bg-paper/88',
					]}
					data-reveal
					style={`animation-delay:${index * 70}ms`}
				>
					<span aria-hidden="true" class="pointer-events-none absolute -right-1 -top-4 font-serif text-7xl leading-none text-gold-main/10">
						{String(index + 1).padStart(2, '0')}
					</span>
					<div class="relative flex items-start justify-between gap-4">
						<div class="flex h-12 w-12 items-center justify-center rounded-inner border border-gold-main/20 bg-gold-main/10 text-gold-soft">
							<Icon name={service.icon} class="h-6 w-6" />
						</div>
						<Badge variant={service.featured ? 'gold' : 'neutral'} size="sm">
							{service.featured ? 'Más solicitado' : 'Servicio'}
						</Badge>
					</div>

					<div class="mb-3.5 mt-4 h-2 w-14 rounded-full bg-linear-to-r from-gold-main to-violet-soft"></div>
					<h3 class="text-lg font-semibold text-ink sm:text-xl">{service.title}</h3>
					<p class="mt-2.5 text-sm leading-6 text-ink/70 sm:mt-3 sm:text-base sm:leading-7">{service.description}</p>

					<Button
						href={`https://wa.me/34628230716?text=${encodeURIComponent(whatsappMessage)}`}
						variant="secondary"
						class="mt-4 w-full sm:mt-5 sm:w-auto"
					>
						{service.cta}
					</Button>
				</article>
			);
		})}
	</div>
</SectionShell>
