---
import { about, certificates, heroStats, interests, profile } from '../../../data/portfolio';
import Button from '../../ui/Button.astro';
import Icon from '../../ui/Icon.astro';

const initials = profile.name
	.split(' ')
	.filter(Boolean)
	.slice(0, 2)
	.map((word) => word[0])
	.join('');

const recommendation = certificates.find((certificate) => certificate.category === 'Recomendaciones');
---

<section id="inicio" class="py-5 sm:py-6 lg:py-10">
	<div class="grid items-center gap-7 lg:grid-cols-[1.15fr_0.85fr]">
		<div class="relative overflow-hidden rounded-panel border border-ink/8 bg-surface/90 p-5 shadow-soft sm:p-7">
			<div aria-hidden="true" class="pointer-events-none absolute -right-16 -top-16 h-44 w-44 rounded-full bg-gold-main/15 blur-3xl"></div>
			<p class="relative inline-flex items-center gap-2 rounded-full border border-gold-main/30 bg-gold-main/10 px-3.5 py-1.5 text-[0.66rem] font-semibold uppercase tracking-[0.22em] text-violet-deep sm:text-xs">
				<span class="h-1.5 w-1.5 rounded-full bg-gold-main"></span>
				{profile.name}
			</p>
			<h1 class="relative mt-4 max-w-3xl font-serif text-[clamp(2rem,7.5vw,4rem)] leading-[1.02] text-ink">{profile.role}</h1>
			<p class="relative mt-5 max-w-2xl text-base leading-7 text-ink/72 sm:text-xl sm:leading-8">{profile.intro}</p>

			<div class="relative mt-6 flex flex-wrap gap-3">
				<Button data-open-section="proyectos" size="md">
					Ver trabajos
				</Button>
				<Button data-open-section="contacto" variant="secondary" size="md">
					Pedir presupuesto
				</Button>
			</div>
		</div>

		<div class="relative">
			<div class="absolute inset-0 rotate-6 rounded-panel bg-linear-to-br from-gold-main/26 via-transparent to-violet-soft/24 blur-sm sm:blur-md"></div>
			<div class="relative overflow-hidden rounded-panel border border-ink/8 bg-surface/92 p-5 shadow-lift sm:p-6">
				<div class="flex items-center gap-4">
					<div class="flex h-16 w-16 shrink-0 items-center justify-center rounded-panel bg-linear-to-br from-violet-deep to-gold-main font-serif text-2xl font-bold text-paper shadow-lift">
						{initials}
					</div>
					<div>
						<p class="font-serif text-xl leading-tight text-ink">{profile.name}</p>
						<p class="text-sm text-ink/60">Desarrollador web · full stack</p>
					</div>
				</div>

				<div class="mt-5 grid grid-cols-2 gap-3">
					<div class="rounded-inner border border-ink/8 bg-paper/80 p-3.5">
						<p class="text-[0.64rem] uppercase tracking-[0.16em] text-violet-deep">Especialidad</p>
						<p class="mt-1.5 text-sm font-medium text-ink">Webs y landings</p>
					</div>
					<div class="rounded-inner border border-ink/8 bg-paper/80 p-3.5">
						<p class="text-[0.64rem] uppercase tracking-[0.16em] text-violet-deep">Automatización</p>
						<p class="mt-1.5 text-sm font-medium text-ink">Power Automate</p>
					</div>
					<div class="rounded-inner border border-ink/8 bg-paper/80 p-3.5">
						<p class="text-[0.64rem] uppercase tracking-[0.16em] text-violet-deep">Enfoque</p>
						<p class="mt-1.5 text-sm font-medium text-ink">Diseño + producto</p>
					</div>
					<div class="rounded-inner border border-gold-main/20 bg-gold-main/10 p-3.5">
						<p class="text-[0.64rem] uppercase tracking-[0.16em] text-violet-deep">Estado</p>
						<p class="mt-1.5 inline-flex items-center gap-1.5 text-sm font-medium text-ink">
							<span class="h-1.5 w-1.5 rounded-full bg-gold-main"></span>
							Disponible
						</p>
					</div>
				</div>
			</div>
		</div>
	</div>

	<div class="mt-8 rounded-panel border border-ink/8 bg-surface/90 p-5 shadow-soft sm:p-8" data-reveal>
		<div class="grid gap-6 lg:grid-cols-[0.9fr_1.1fr] lg:gap-10">
			<div>
				<p class="inline-flex items-center gap-2 rounded-full border border-gold-main/25 bg-gold-main/10 px-3 py-1 text-[0.66rem] font-semibold uppercase tracking-[0.2em] text-violet-deep sm:text-xs sm:tracking-[0.24em]">
					<span class="h-1.5 w-1.5 rounded-full bg-gold-main"></span>
					{about.heading}
				</p>
				<h2 class="mt-3 font-serif text-3xl leading-tight text-ink sm:text-4xl">{about.title}</h2>
				<p class="mt-4 text-base leading-7 text-ink/75 sm:text-lg sm:leading-8">{about.lead}</p>
				{recommendation && (
					<Button href={encodeURI(recommendation.href)} variant="ghost" class="mt-5">
						<Icon name="award" class="h-4 w-4" />
						Ver carta de recomendación
					</Button>
				)}
			</div>

			<div class="space-y-5">
				<p class="text-sm leading-7 text-ink/70 sm:text-base">{about.body}</p>
				<div class="grid gap-3 sm:grid-cols-2">
					{interests.map((interest, index) => (
						<article
							class="group flex gap-3.5 rounded-inner border border-ink/8 bg-paper/80 p-4 transition duration-300 hover:-translate-y-0.5 hover:border-gold-main/30 hover:shadow-lift"
							data-reveal
							style={`animation-delay:${index * 70}ms`}
						>
							<div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-inner border border-gold-main/20 bg-gold-main/10 text-gold-soft">
								<Icon name={interest.icon} />
							</div>
							<div>
								<h3 class="text-sm font-semibold text-ink sm:text-base">{interest.title}</h3>
								<p class="mt-1 text-xs leading-5 text-ink/65 sm:text-sm sm:leading-6">{interest.description}</p>
							</div>
						</article>
					))}
				</div>
			</div>
		</div>
	</div>

	<div class="mt-6 grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
		{heroStats.map((stat) => (
			<div class="rounded-card border border-ink/8 bg-paper/82 p-4 shadow-soft sm:p-5">
				<p class="font-serif text-3xl font-bold text-gold-main sm:text-4xl">{stat.value}</p>
				<p class="mt-2 text-sm text-ink/62">{stat.label}</p>
			</div>
		))}
	</div>
</section>
