---
import { about, certificates, heroStats, interests, profile } from '../../../data/portfolio';
import Button from '../../ui/Button.astro';
import Icon from '../../ui/Icon.astro';

const facts = [
	{ label: 'Especialidad', value: 'Webs y landings' },
	{ label: 'Automatización', value: 'Power Automate' },
	{ label: 'Enfoque', value: 'Diseño + producto' },
];

const recommendation = certificates.find((certificate) => certificate.category === 'Recomendaciones');
---

<section id="inicio" class="pb-4">
	<div class="grid gap-10 lg:grid-cols-[1.45fr_1fr] lg:gap-16">
		<div>
			<h1 class="font-serif text-[clamp(2.1rem,6vw,3.4rem)] leading-[1.05] text-ink">{profile.role}</h1>
			<p class="mt-5 max-w-2xl text-base leading-7 text-ink-soft sm:text-lg sm:leading-8">{profile.intro}</p>
			<div class="mt-7 flex flex-wrap items-center gap-3">
				<Button data-open-section="proyectos" size="md">
					Ver trabajos
				</Button>
				<Button data-open-section="contacto" variant="secondary" size="md">
					Pedir presupuesto
				</Button>
			</div>
		</div>

		<div class="lg:pt-2">
			<dl class="border-y border-line">
				{facts.map((fact) => (
					<div class="flex items-baseline justify-between gap-6 border-b border-line py-3.5 last:border-b-0">
						<dt class="text-xs uppercase tracking-[0.16em] text-ink-muted">{fact.label}</dt>
						<dd class="text-right text-sm font-medium text-ink">{fact.value}</dd>
					</div>
				))}
			</dl>
			<p class="mt-4 inline-flex items-center gap-2 text-sm text-ink-soft">
				<span class="h-1.5 w-1.5 rounded-full bg-gold-main"></span>
				Disponible para nuevos proyectos
			</p>
		</div>
	</div>

	<div class="mt-16 grid gap-10 border-t border-line pt-12 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
		<div>
			<h2 class="font-serif text-3xl leading-tight text-ink sm:text-4xl">{about.title}</h2>
			<p class="mt-4 max-w-md text-base leading-7 text-ink-soft sm:text-lg sm:leading-8">{about.lead}</p>
			{recommendation && (
				<Button href={encodeURI(recommendation.href)} variant="ghost" class="mt-5">
					Ver carta de recomendación
					<Icon name="arrowRight" class="h-4 w-4" strokeWidth={1.6} />
				</Button>
			)}
		</div>

		<div class="lg:pt-2">
			<p class="max-w-2xl text-base leading-7 text-ink-soft">{about.body}</p>
			<h3 class="mt-9 text-xs uppercase tracking-[0.18em] text-ink-muted">Fuera del código</h3>
			<ul class="mt-1 divide-y divide-line">
				{interests.map((interest) => (
					<li class="flex gap-4 py-4">
						<Icon name={interest.icon} class="mt-0.5 h-5 w-5 shrink-0 text-gold-main" />
						<div>
							<h4 class="text-sm font-semibold text-ink">{interest.title}</h4>
							<p class="mt-0.5 text-sm leading-6 text-ink-soft">{interest.description}</p>
						</div>
					</li>
				))}
			</ul>
		</div>
	</div>

	<dl class="mt-16 grid grid-cols-2 gap-x-8 gap-y-10 border-t border-line pt-10 sm:grid-cols-4">
		{heroStats.map((stat) => (
			<div>
				<dt class="sr-only">{stat.label}</dt>
				<dd>
					<span class="font-serif text-3xl text-gold-main sm:text-4xl">{stat.value}</span>
					<span class="mt-2 block max-w-[16ch] text-sm leading-6 text-ink-soft">{stat.label}</span>
				</dd>
			</div>
		))}
	</dl>
</section>
