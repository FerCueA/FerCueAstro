---
import { contactLinks } from '../../../data/portfolio';
import Icon from '../../ui/Icon.astro';
import SectionShell from '../../ui/SectionShell.astro';

const priorityChannels = new Set(['Correo', 'WhatsApp']);

const contactIcons: Record<string, 'email' | 'linkedin' | 'github' | 'whatsapp'> = {
	Correo: 'email',
	LinkedIn: 'linkedin',
	GitHub: 'github',
	WhatsApp: 'whatsapp',
};
---

<SectionShell
	id="contacto"
	index="06"
	kicker="Contacto"
	title="Cuéntame tu idea y la aterrizamos"
	description="Sin formularios ni intermediarios. Escríbeme por el canal que uses habitualmente y hablamos de lo que necesitas."
	meta={[`${contactLinks.length} canales`, 'Respuesta en menos de 24 h']}
>
	<ul class="border-t border-line">
		{contactLinks.map((item, index) => (
			<li data-reveal style={`animation-delay:${index * 50}ms`}>
				<a
					href={item.href}
					target="_blank"
					rel="noreferrer"
					class="group flex items-center justify-between gap-6 border-b border-line py-5"
				>
					<span class="flex items-center gap-4">
						<Icon
							name={contactIcons[item.label] ?? 'email'}
							class="h-5 w-5 shrink-0 text-ink-muted transition-colors group-hover:text-gold-main"
						/>
						<span>
							<span class="block text-sm font-medium text-ink sm:text-base">{item.label}</span>
							<span class="mt-0.5 block text-sm text-ink-muted">{item.value}</span>
						</span>
					</span>
					<span class="flex shrink-0 items-center gap-3 text-sm text-ink-muted transition-colors group-hover:text-gold-main">
						{priorityChannels.has(item.label) && <span class="text-xs uppercase tracking-[0.16em] text-gold-main">Prioritario</span>}
						<Icon name="arrowRight" class="h-4 w-4" strokeWidth={1.6} />
					</span>
				</a>
			</li>
		))}
	</ul>
</SectionShell>
